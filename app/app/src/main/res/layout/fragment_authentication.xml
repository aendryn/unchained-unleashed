<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ========================= Real-Debrid section ========================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRealDebridAuth"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- header: icon + name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRdAuthIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/real_debrid"
                        android:src="@drawable/ic_service_realdebrid" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/real_debrid"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvLoginMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/login_message_placeholder"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tvAuthenticationLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autoLink="web"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:nextFocusRight="@id/tvUsePrivateToken"
                    android:nextFocusDown="@id/tvUsePrivateToken"
                    android:scrollHorizontally="true"
                    android:textAlignment="center"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/cbLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/waiting_link" />

                <CheckBox
                    android:id="@+id/cbSecret"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/waiting_user_auth" />

                <LinearLayout
                    android:id="@+id/llUserCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUserCodeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:text="@string/copy_code"
                        android:textIsSelectable="true" />

                    <Button
                        android:id="@+id/bCopyLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="@string/copy" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/waiting_token" />

                <TextView
                    android:id="@+id/tvUsePrivateToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:autoLink="web"
                    android:gravity="center"
                    android:nextFocusUp="@id/tvAuthenticationLink"
                    android:nextFocusDown="@id/tiPrivateCode"
                    android:text="@string/add_private_token_message" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tfPrivateCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:hint="@string/private_token"
                        android:importantForAutofill="no"
                        android:nextFocusLeft="@id/tvAuthenticationLink"
                        android:nextFocusRight="@id/bPastePrivateCode"
                        android:nextFocusUp="@id/tvUsePrivateToken"
                        android:nextFocusDown="@id/bInsertPrivate"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tiPrivateCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/bPastePrivateCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:nextFocusLeft="@id/tfPrivateCode"
                        android:nextFocusRight="@id/bInsertPrivate"
                        android:nextFocusDown="@id/bInsertPrivate"
                        android:text="@string/paste"
                        app:icon="@drawable/icon_paste" />
                </LinearLayout>

                <Button
                    android:id="@+id/bInsertPrivate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nextFocusLeft="@id/tfPrivateCode"
                    android:nextFocusUp="@id/tfPrivateCode"
                    android:text="@string/save" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ TorBox section ============================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvTorBoxAuth"
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- header: icon + name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivTbAuthIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/torbox"
                        android:src="@drawable/ic_service_torbox" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/torbox"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvUseTorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/torbox_login_message_standalone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tfTorBoxKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    android:hint="@string/torbox_api_key_title"
                    android:importantForAutofill="no"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tiTorBoxKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/bInsertTorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/torbox_connect_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
